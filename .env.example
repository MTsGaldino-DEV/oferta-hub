# ---------------------------------------------------------------
# INFRA
# ---------------------------------------------------------------
DATABASE_URL="postgresql://oferta:oferta@localhost:5432/ofertahub"
PORT=3333
# URL publica da API (usada nos links curtos). Precisa ser https em producao.
PUBLIC_URL="http://localhost:3333"

# Chave de 32 bytes em hex que criptografa as credenciais no banco (AES-256-GCM).
# Gere com: npm run keygen  -- NUNCA versione esse valor.
MASTER_KEY=""

# Senha unica de acesso ao dashboard.
DASHBOARD_PASSWORD="troque-isso"
SESSION_SECRET="troque-isso-tambem"

# ---------------------------------------------------------------
# WHATSAPP (Baileys - biblioteca nao oficial)
# ---------------------------------------------------------------
# Pasta onde a sessao do numero secundario fica salva. Faca backup dela.
WA_STATE_DIR="./auth_state"
# Intervalo minimo entre dois envios, em segundos. Nao abaixe de 45.
WA_MIN_INTERVAL_SECONDS=90
# Teto de envios por dia. Grupos de oferta que passam disso tomam ban rapido.
WA_DAILY_CAP=40
# Intervalo minimo entre remocoes de grupo (moderacao), em segundos. Nao abaixe de 10.
WA_MODERACAO_INTERVALO_SEGUNDOS=20
# Teto de remocoes por dia. Conservador de proposito.
WA_MODERACAO_TETO_DIARIO=30

# ---------------------------------------------------------------
# CREDENCIAIS DAS PLATAFORMAS
# Voce NAO precisa preencher aqui. O jeito recomendado e cadastrar
# pelo dashboard (Conexoes), que grava criptografado no banco.
# Estas variaveis existem so como fallback/seed.
# ---------------------------------------------------------------
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
AMAZON_PARTNER_TAG=""
AMAZON_HOST="webservices.amazon.com.br"
AMAZON_REGION="us-east-1"

ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
ML_REFRESH_TOKEN=""

SHOPEE_APP_ID=""
SHOPEE_SECRET=""

ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_TRACKING_ID=""

AWIN_API_TOKEN=""
AWIN_PUBLISHER_ID=""

LOMADEE_APP_TOKEN=""
LOMADEE_SOURCE_ID=""

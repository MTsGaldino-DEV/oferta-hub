+  border-color: #3a3b40;
+}
+
+[data-theme='dark'] .rail__count,
+[data-theme='dark'] .btn--tag,
+[data-theme='dark'] .tag__score,
+[data-theme='dark'] .tabs__item[data-on='true'] span,
+[data-theme='dark'] .card__selo,

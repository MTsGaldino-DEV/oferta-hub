+  color: #16171a;
+}
+
+/* Caixa de estado vazio usava branco translúcido sobre o papel claro;
+   em fundo escuro isso lava pra um bloco claro com texto var(--ink)
+   (agora claro) em cima -- quase ilegível. */
+[data-theme='dark'] .empty {
+  background: rgba(255, 255, 255, 0.04);
+}
+
+/* O poço da foto do card fica claro de propósito nos dois temas (fundo

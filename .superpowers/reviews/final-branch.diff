+
+/* ---------------------------------------------------------------
+   Modo escuro: ajustes pontuais
+   O flip de token quebra qualquer lugar que usava --ink como FUNDO
+   escuro fixo (rail, botão primário, aba ativa, mark do login) --
+   nesses o --ink virou texto claro, então o fundo precisa ficar preso
+   num tom escuro. E qualquer lugar com texto var(--ink) sobre fundo
+   var(--brand)/var(--tag) (que não muda de cor) também precisa do
+   texto preso em escuro, senão vira texto quase-branco sobre amarelo.
+   --------------------------------------------------------------- */
+
+[data-theme='dark'] .rail {
+  background: #16171a;
+}
+
+[data-theme='dark'] .login__mark {
+  background: #16171a;
